# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    DISPLAY "Enter the lower bound:"
    INPUT lower_bound

    DISPLAY "Enter the upper bound:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        DISPLAY "Invalid range. Upper bound must be greater than lower bound."
        DISPLAY "Enter the lower bound:"
        INPUT lower_bound
        DISPLAY "Enter the upper bound:"
        INPUT upper_bound
    END WHILE

    # Generate a random number within the range.
    SET secret_number = RANDOM INTEGER between lower_bound and upper_bound

    # Ask the player to guess.
    DISPLAY "Guess a number between", lower_bound, "and", upper_bound
    INPUT player_guess

    # Validate the player's guess.
    WHILE player_guess is not a valid integer OR
          player_guess < lower_bound OR player_guess > upper_bound
        DISPLAY "Invalid guess. Enter a number within the range."
        INPUT player_guess
    END WHILE

    # Continue until the player guesses correctly.
    WHILE player_guess != secret_number

        IF player_guess < secret_number THEN
            DISPLAY "Too low. Try again."
        ELSE
            DISPLAY "Too high. Try again."
        END IF

        DISPLAY "Enter another guess:"
        INPUT player_guess

        WHILE player_guess is not a valid integer OR
              player_guess < lower_bound OR player_guess > upper_bound
            DISPLAY "Invalid guess. Enter a number within the range."
            INPUT player_guess
        END WHILE

    END WHILE

    # Winning message.
    DISPLAY "Congratulations! You guessed the correct number!"

END hilow_game
